  "022658da2145e650f2ae7fd13c92c95d": [
    {
      "doc": "ada_pharma_approaches",
      "text": "Metformin is available in an immediate-release form for twice-daily dosing or as an extended-release form that can be given once daily."
    }
  ],
  "a9c28f919bd39a2059965553a2a8bd9a": [
    {
      "doc": "ada_pharma_approaches",
      "text": "starting doses can be estimated based on body weight (0.1\u20130.2 units/kg/day)"
    }
  ],
  "d866de0c67da08c61daa8ee501f83bed": [
    {
      "doc": "ada_pharma_approaches",
      "text": "Starting with a single prandial dose with the largest meal of the day is simple and effective, and it can be advanced to a plan with multiple prandial doses if necessary (179). We suggest starting with a prandial insulin dose of 4 units or 10% of the amount of basal insulin at the largest meal or the meal with the greatest postprandial excursion."
    }
  ],
  "fadba2a88e3589308627dea09cc65811": [
    {
      "doc": "ada_pharma_approaches",
      "text": "Start 10 units per day or 0.1\u20130.2 units/kg per day"
    }
